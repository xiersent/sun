<!-- templates/intersection-item.ejs -->
<div class="sun-intersectionItem"
     data-timestamp="<%= data.timestamp %>"
     data-index="<%= data.index || 0 %>">
    
    <div class="sun-intersectionInfo">
        <span class="sun-intersectionPeriod"><%= data.timeStr %></span>
        <span class="sun-intersectionValue">#<%= data.index + 1 %></span>
        <div class="sun-intersectionMatchType">
            <span style="color: <%= data.wave1Color || '#666' %>"><%= data.wave1Name %></span>
            ×
            <span style="color: <%= data.wave2Color || '#666' %>"><%= data.wave2Name %></span>
        </div>
        <div class="sun-intersectionMatchType">Периоды: <%= data.wave1Period %>д × <%= data.wave2Period %>д</div>
    </div>
</div>
