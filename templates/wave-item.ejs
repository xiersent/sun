<!-- templates/wave-item.ejs -->
<div class="sun-listItem sun-listItemWave sun-waveInGroup sun-groupChildrenItem <%= data.editing ? 'sun-listItemEditing' : '' %>"
    data-id="<%= data.id %>"
    data-type="wave"
    <% if (data.parentGroupId) { %>
        data-parent-group-id="<%= data.parentGroupId %>"
    <% } %>
    draggable="false"
    data-index="<%= data.index %>"
    data-wave-id="<%= data.id %>">
    
    <div class="sun-listItemDragHandle sun-waveDragHandle sun-listItemSaveFlashChild<%= data.editing ? ' sun-listItemDragHandleMuted' : '' %>" draggable="<%= !data.editing %>" title="Перетащить сигнал">⋮⋮</div>
    
    <div class="sun-listItemContent sun-listItemSaveFlashChild">
        <div class="sun-listItemNormalView<%= data.editing ? ' sun-listItemViewHidden' : '' %>">
            <div class="sun-listItemRow">
                <div class="sun-listItemLeft">
                    <div class="sun-waveControlsInline">
                        <input type="checkbox" class="sun-waveVisibilityCheck" autocomplete="off"
                               <%= data.visible ? 'checked' : '' %> 
                               data-id="<%= data.id %>" 
                               title="Видимость">
                        
                        <input type="checkbox" class="sun-waveBVisibilityCheck" autocomplete="off"
                               <%= data.bold ? 'checked' : '' %> 
                               data-id="<%= data.id %>" 
                               title="Видимость слоя B (вторая персона), как левый чекбокс — для слоя A">
                        
                        <div class="sun-waveColorPreviewSmall" 
                             style="background-color: <%= data.color || '#666666' %>;" 
                             data-id="<%= String(data.id) %>" 
                             title="Редактировать цвет"></div>
                        
                        <input type="checkbox" class="sun-waveCornerColorCheck" autocomplete="off"
                               <%= data.cornerColor ? 'checked' : '' %> 
                               data-id="<%= data.id %>" 
                               title="Окрасить края в цвет сигнала">
                    </div>
                    <div class="sun-listItemTitleContainer">
                        <div class="sun-listItemTitle">
                            <%= data.name %>
                            <span class="sun-wavePeriodBadge"><%= data.period %> дней</span>
                        </div>
                    </div>
                </div>
                
                <div class="sun-listItemRight">
                    <div class="sun-listItemValue">
                        <%= data.description || 'Сигнал' %>
                    </div>
                    <div class="sun-listItemActions">
                        <button type="button" class="sun-uiBtn sun-editBtn" data-id="<%= data.id %>" data-type="wave" title="Редактировать" aria-label="Редактировать">✎</button>
                        <button type="button" class="sun-uiBtn sun-deleteDateBtn" data-id="<%= data.id %>" data-type="wave" title="Уничтожить" aria-label="Уничтожить">⨯</button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Форма редактирования -->
        <div class="sun-listItemEditForm<%= data.editing ? ' sun-listItemViewShown' : '' %>">
            <div class="sun-listItem__edit-row">
                <input type="text" class="sun-listItem__edit-input" id="editWaveName<%= data.id %>" value="<%= data.name %>">
            </div>
            <div class="sun-listItem__edit-row">
                <input type="number" class="sun-listItem__edit-input" id="editWavePeriod<%= data.id %>" value="<%= data.period %>" min="0.1" step="0.1">
            </div>
            <div class="sun-listItem__edit-row">
                <select class="sun-listItem__edit-input" id="editWaveType<%= data.id %>">
                    <option value="solid" <%= data.typeValue === 'solid' ? 'selected' : '' %>>Сплошная</option>
                    <option value="dashed" <%= data.typeValue === 'dashed' ? 'selected' : '' %>>Пунктирная</option>
                    <option value="dotted" <%= data.typeValue === 'dotted' ? 'selected' : '' %>>Точечная</option>
                    <option value="zigzag" <%= data.typeValue === 'zigzag' ? 'selected' : '' %>>Зигзагообразная</option>
                    <option value="dash-dot" <%= data.typeValue === 'dash-dot' ? 'selected' : '' %>>Штрих-линия</option>
                    <option value="long-dash" <%= data.typeValue === 'long-dash' ? 'selected' : '' %>>Длинный штрих</option>
                </select>
            </div>
            <div class="sun-listItem__edit-row">
                <label class="sun-listItem__edit-label">Цвет:</label>
                <input type="color" class="sun-colorInput" id="editWaveColor<%= data.id %>" value="<%= data.color %>">
            </div>
            <div class="sun-listItemEditActions">
                <button type="button" class="sun-saveBtn sun-uiBtn" data-id="<%= data.id %>" data-type="wave" title="Сохранить" aria-label="Сохранить">💾</button>
                <button type="button" class="sun-cancelBtn sun-uiBtn" data-id="<%= data.id %>" data-type="wave" title="Отмена" aria-label="Отмена">↩</button>
            </div>
        </div>
    </div>
</div>