<!-- templates/group-item.ejs -->
<div class="sun-listItem sun-listItemGroup <%= data.editing ? 'sun-listItemEditing' : '' %> <%= data.expanded ? 'sun-listItemExpanded' : '' %>"
    data-id="<%= data.id %>"
    data-type="group"
    draggable="false"
    data-index="<%= data.index %>">
    
    <div class="sun-listItemDragHandle sun-listItemSaveFlashChild<%= data.editing ? ' sun-listItemDragHandleMuted' : '' %>" draggable="<%= !data.editing %>" title="Перетащить группу">⋮⋮</div>
    
    <div class="sun-listItemContent sun-listItemSaveFlashChild">
        <!-- Нормальный вид -->
        <div class="sun-listItemNormalView<%= data.editing ? ' sun-listItemViewHidden' : '' %>">
            <div class="sun-listItemRow">
                <div class="sun-listItemLeft">
                    <div class="sun-listItemTitleContainer">
                        <input type="checkbox" class="sun-waveGroupToggle" autocomplete="off"
                               <%= data.enabled ? 'checked' : '' %> 
                               data-group-id="<%= data.id %>" 
                               title="Включить/выключить группу">
                        
                        <div class="sun-listItemTitle">
                            <%= data.name %>
                        </div>
                    </div>
                </div>
                
                <div class="sun-listItemRight">
                    <div class="sun-listItemValue">
                        <span class="sun-groupStats">
                            <span class="sun-groupStatTotal" title="Отключить все слои (A и B) у всех сигналов группы">Всего: <%= data.waveCount %></span>
                            <% var _a = typeof data.enabledCountA !== 'undefined' ? data.enabledCountA : (data.enabledCount || 0); if (_a > 0) { %>
                            <span class="sun-groupStatA" title="Отключить слой A у всех сигналов группы">Включено: <%= _a %></span>
                            <% } %>
                            <% var _b = typeof data.enabledCountB !== 'undefined' ? data.enabledCountB : 0; if (_b > 0) { %>
                            <span class="sun-groupStatB" title="Отключить слой B у всех сигналов группы">Включено: <%= _b %></span>
                            <% } %>
                        </span>
                    </div>
                    <div class="sun-listItemActions">
                        <button type="button" class="sun-uiBtn sun-expandCollapseBtn" 
                                data-id="<%= data.id %>" 
                                data-type="group"
                                title="<%= data.expanded ? 'Свернуть' : 'Развернуть' %>"
                                aria-label="<%= data.expanded ? 'Свернуть' : 'Развернуть' %>"
                                aria-expanded="<%= data.expanded ? 'true' : 'false' %>"><%= data.expanded ? '▼' : '▶' %></button>
                        <button type="button" class="sun-uiBtn sun-editBtn" 
                                data-id="<%= data.id %>" 
                                data-type="group"
                                title="<%= data.editing ? 'Редактирование…' : 'Редактировать' %>"
                                aria-label="<%= data.editing ? 'Редактирование…' : 'Редактировать' %>">✎</button>
                        <button type="button" class="sun-uiBtn sun-deleteDateBtn" 
                                data-id="<%= data.id %>" 
                                data-type="group"
                                title="Уничтожить"
                                aria-label="Уничтожить">⨯</button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Форма редактирования группы -->
        <div class="sun-listItemEditForm<%= data.editing ? ' sun-listItemViewShown' : '' %>">
            <div class="sun-listItem__edit-row">
                <input type="text" placeholder="Название группы" class="sun-listItem__edit-input" id="editGroupName<%= data.id %>" value="<%= data.name %>">
            </div>
            <div class="sun-listItemEditActions">
                <button type="button" class="sun-saveBtn sun-uiBtn" data-id="<%= data.id %>" data-type="group" title="Сохранить" aria-label="Сохранить">💾</button>
                <button type="button" class="sun-cancelBtn sun-uiBtn" data-id="<%= data.id %>" data-type="group" title="Отмена" aria-label="Отмена">↩</button>
            </div>
        </div>
        
        <!-- Дочерние элементы (волны/сигналы) -->
        <div class="sun-groupChildren<%= data.expanded ? ' sun-groupChildrenOpen' : '' %>" style="<%= data.expanded ? 'display: block;' : 'display: none;' %>">
            <% if (data.children && data.children.length > 0) { %>
                <!--ZARAZA_WAVE_CHILDREN-->
            <% } else { %>
                <div class="sun-noWavesMessage sun-groupChildrenItem">
                    <span style="color: #999; font-style: italic; font-size: 11px; padding: 10px;">
                        Нет сигналов в этой группе
                    </span>
                </div>
            <% } %>
        </div>
    </div>
</div>