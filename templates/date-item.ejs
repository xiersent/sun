<!-- templates/date-item.ejs -->
<% var _attrEsc = function (s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }; %>
<% var _textEsc = function (s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }; %>
<% var _descForTitle = String(data.description || '').trim(); var _hoverFallback = String(data.name || '') + '\n-\n' + String(data.formattedDate || ''); if (_descForTitle) { _hoverFallback += '\n-\n' + _descForTitle; } var _dateTitleHover = _attrEsc(data.hoverTitle != null ? data.hoverTitle : _hoverFallback); %>
<% var _dateTitleValue = _attrEsc(data.formattedDate + (data.yearsFromCurrent > 0 ? ' [' + data.yearsFromCurrent + ']' : '')); %>
<div class="list-item list-item--date 
    <%= data.active ? 'active' : '' %> 
    <%= data.editing ? 'list-item--editing' : '' %>"
    data-id="<%= data.id %>"
    data-type="date"
    data-person-group-id="<%= data.personGroupId || '' %>"
    draggable="false"
    data-index="<%= data.index %>">
    
    <div class="list-item__drag-handle date-drag-handle" draggable="<%= !data.editing %>" title="Перетащить персону">⋮⋮</div>
    
    <div class="list-item__content">
        <!-- Нормальный вид -->
        <div class="list-item__normal-view">
            <div class="list-item__row">
                <div class="list-item__left">
                    <!-- Два чекбокса выделения -->
                    <div class="date-selection-checks">
                        <input type="checkbox" class="date-checkbox" autocomplete="off"
                               <%= data.selectedTypeA ? 'checked' : '' %>
                               data-id="<%= data.id %>" 
                               data-type="a"
                               title="Выделение типа A">
                        <input type="checkbox" class="date-checkbox" autocomplete="off"
                               <%= data.selectedTypeB ? 'checked' : '' %>
                               data-id="<%= data.id %>" 
                               data-type="b"
                               title="Выделение типа B">
                    </div>
                    
                    <div class="list-item__title-container">
                        <div class="list-item__title date-name" title="<%= _dateTitleHover %>">
                            <%= data.name %>
                        </div>
                        <span class="list-item__icon date-star" title="<%= _dateTitleHover %>">★</span>
                    </div>
                </div>
                
                <div class="list-item__right">
                    <div class="list-item__value" title="<%= _dateTitleValue %>">
                        <%= data.formattedDate %>
                        <% if (data.yearsFromCurrent > 0) { %>
                            [<%= data.yearsFromCurrent %>]
                        <% } %>
                    </div>
                    <div class="list-item__actions">
                        <button type="button" class="ui-btn edit-btn" data-id="<%= data.id %>" data-type="date" title="Редактировать" aria-label="Редактировать">✎</button>
                        <button type="button" class="ui-btn delete-date-btn" data-id="<%= data.id %>" data-type="date" title="Уничтожить" aria-label="Уничтожить">⨯</button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Форма редактирования -->
        <div class="list-item__edit-form">
            <div class="list-item__edit-row list-item__edit-row--date-main">
                <input type="text" class="list-item__edit-input date-name-edit" id="editDateName<%= data.id %>" value="<%= data.name %>" placeholder="Название">
                <input type="date" class="date-input list-item__edit-input" id="editDateValue<%= data.id %>" value="<%= data.dateForInput %>">
                <div class="list-item__edit-actions">
                    <button type="button" class="ui-btn delete-date-btn" data-id="<%= data.id %>" data-type="date" title="Уничтожить" aria-label="Уничтожить">⨯</button>
                    <button type="button" class="save-btn ui-btn" data-id="<%= data.id %>" data-type="date" title="Сохранить" aria-label="Сохранить">💾</button>
                    <button type="button" class="cancel-btn ui-btn" data-id="<%= data.id %>" data-type="date" title="Отмена" aria-label="Отмена">↩</button>
                </div>
            </div>
            <div class="list-item__edit-row list-item__edit-row--full">
                <textarea class="list-item__edit-input date-description-edit" id="editDateDescription<%= data.id %>" rows="2" placeholder="Заметка к выбранной персоне…" aria-label="Заметка к выбранной персоне"><%= _textEsc(data.description || '') %></textarea>
            </div>
        </div>
    </div>
</div>