<!-- templates/person-group-item.ejs — группа персон (только порядок и сворачивание) -->
<% var _attrEsc = function (s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }; %>
<div class="sun-listItem sun-listItemPersonGroup <%= data.editing ? 'sun-listItemEditing' : '' %> <%= data.expanded ? 'sun-listItemExpanded' : '' %>"
    data-id="<%= data.id %>"
    data-type="personGroup"
    draggable="false"
    data-index="<%= data.index %>">
    
    <div class="sun-listItemDragHandle sun-listItemSaveFlashChild<%= data.editing ? ' sun-listItemDragHandleMuted' : '' %>" draggable="<%= !data.editing %>" title="Перетащить группу">⋮⋮</div>
    
    <div class="sun-listItemContent sun-listItemSaveFlashChild">
        <div class="sun-listItemNormalView<%= data.editing ? ' sun-listItemViewHidden' : '' %>">
            <div class="sun-listItemRow">
                <div class="sun-listItemLeft">
                    <div class="sun-listItemTitleContainer">
                        <div class="sun-listItemTitle" title="<%= _attrEsc(data.name) %>">
                            <%= data.name %>
                        </div>
                    </div>
                </div>
                
                <div class="sun-listItemRight">
                    <div class="sun-listItemValue">
                        <span class="sun-groupStats">
                            <span class="sun-groupTotalCount" title="Персон в группе">
                                Персон: <%= data.dateCount %>
                            </span>
                        </span>
                    </div>
                    <div class="sun-listItemActions">
                        <button type="button" class="sun-uiBtn sun-expandCollapseBtn personGroupExpandBtn" 
                                data-id="<%= data.id %>" 
                                data-type="personGroup"
                                title="<%= data.expanded ? 'Свернуть' : 'Развернуть' %>"
                                aria-label="<%= data.expanded ? 'Свернуть' : 'Развернуть' %>"
                                aria-expanded="<%= data.expanded ? 'true' : 'false' %>"><%= data.expanded ? '▼' : '▶' %></button>
                        <button type="button" class="sun-uiBtn sun-editBtn" 
                                data-id="<%= data.id %>" 
                                data-type="personGroup"
                                title="<%= data.editing ? 'Редактирование…' : 'Редактировать' %>"
                                aria-label="<%= data.editing ? 'Редактирование…' : 'Редактировать' %>">✎</button>
                        <button type="button" class="sun-uiBtn sun-deleteDateBtn" 
                                data-id="<%= data.id %>" 
                                data-type="personGroup"
                                title="Уничтожить"
                                aria-label="Уничтожить">⨯</button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="sun-listItemEditForm<%= data.editing ? ' sun-listItemViewShown' : '' %>">
            <div class="sun-listItem__edit-row">
                <input type="text" placeholder="Название группы" class="sun-listItem__edit-input" id="editPersonGroupName<%= data.id %>" value="<%= data.name %>">
            </div>
            <div class="sun-listItemEditActions">
                <button type="button" class="sun-saveBtn sun-uiBtn" data-id="<%= data.id %>" data-type="personGroup" title="Сохранить" aria-label="Сохранить">💾</button>
                <button type="button" class="sun-cancelBtn sun-uiBtn" data-id="<%= data.id %>" data-type="personGroup" title="Отмена" aria-label="Отмена">↩</button>
            </div>
        </div>
        
        <div class="sun-groupChildren sun-personGroupChildren<%= data.expanded ? ' sun-groupChildrenOpen' : '' %>" style="<%= data.expanded ? 'display: block;' : 'display: none;' %>">
            <% if (data.children && data.children.length > 0) { %>
            <% } else { %>
                <div class="sun-noWavesMessage sun-groupChildrenItem">
                    <span style="color: #999; font-style: italic; font-size: 11px; padding: 10px;">
                        Нет персон в этой группе
                    </span>
                </div>
            <% } %>
        </div>
    </div>
</div>
